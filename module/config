# TB378FC HyperOS 修复 Lite —— 运行配置
#
# 只有系统修复，全部动作在开机后执行一次就结束 —— 本模块**没有任何常驻进程**。
# 开关可在 KernelSU 管理器的 WebUI 里改（推荐），也可以直接编辑本文件。
#
# 三条规则：
#   1) 这三项都只靠模块（root + 内核/属性/包管理）就能做，不需要 App，默认全开。
#   2) ⑭ 开发者选项是**崩溃修复，没有开关**，永远生效。
#   3) 每一项都能用模块目录下的 disable-* 标记文件强制关掉，优先级高于本文件。
#
# 布尔键的写法：1/true/yes/on = 开，其它（0/false/no/off）= 关。
# 改完本文件后重启设备（或重启模块）生效 —— 没有守护进程需要重启，因为动作本身只在开机跑一次。
#
# 注意：本文件由 post-fs-data.sh / service.sh 按行解析（**不是 source**），所以值里可以安全地
# 出现空格、引号、& | \ 等字符，不会被当成 shell 代码执行。


# ② 修补移植包改坏的 PowerKeeper 字节码（两处），恢复 MIUI 省电管理。
#    两个脚本都消费本键：post-fs-data.sh 挂一次（让 PMS 在包扫描阶段就看到补丁版），
#    service.sh 在 boot_completed 之后再 umount + mount 一次 —— **只有这一次对 App 生效**
#    （KernelSU 会把模块挂载从 App 进程的 namespace 里卸掉；时机问题详见 README 第一节的
#    「让补丁真正生效要绕开三个坑」）。挂的是**父目录** /system_ext/app/PowerKeeper，
#    不是那个 APK 文件：父目录一挂，ROM 预编译的 oat/ 也一起被盖掉。
#    关掉后 com.miui.powerkeeper 开机即崩。
FIX_POWERKEEPER=1

# ③ 停掉 hyper_bpfloader 的监视器（init 服务名 dynbpfloader）。
#    该监视器检查 MIUI 私有 BPF 程序（MiuiMmStat / MiuiMmTrace）是否已 pin；那套 .o 引用
#    6.10+ 内核符号而本机内核是 6.6.82，89 个程序一个都加载不了 → 它判定"系统损坏"，
#    写 recovery 引导块并 reboot,recovery（实测：不开容器时忍着，一旦用 DroidSpaces 容器就触发）。
#    该服务是 init 里的 disabled 服务、只由 on property:sys.boot_completed=1 && ro.debuggable=1
#    拉起一次，所以开机后 ctl.stop 一次即永久生效，不需要看护进程。
FIX_BPFMON=1

# ④ 停掉三个死电话包（本机无 modem，它们每秒崩数百次）。
#    本机 ro.baseband=apq 是纯应用处理器、没有集成 modem，框架没有 FEATURE_TELEPHONY，
#    而移植包搬来了声明成 persistent 的小米/QTI 电话栈 → getSystemService 返回 null →
#    NullPointerException 每秒崩几百次，白烧 zygote / system_server。
#    停用状态写在 packages.xml 里跨重启保持，所以每次开机复查一遍即可。
FIX_TELEPHONY=1

# ⑭ 开发者选项（SELinux）是崩溃修复，**没有开关**，永远生效：
#    补 system_app → logpersistd_logging_prop 两条最小权限，
#    否则 Enforcing 下打开「设置 → 开发者选项」必现闪退。
#    免重启手动重应用：sh service.sh --sepolicy
