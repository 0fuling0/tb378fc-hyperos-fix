# 唤醒策略配置
#
# REFRESH_SECONDS=0   只按吸附状态触发（默认）：
#                       取下 -> 发唤醒命令
#                       吸附 -> 读电量并发一条通知
#                     其余时间不打扰，笔按自己的节奏休眠
#
# REFRESH_SECONDS=120 额外安全网：未吸附期间每 120 秒补发一次唤醒。
#                     适合"笔搁在桌上睡死了、你又不想吸附一下"的场景，
#                     代价是笔在未吸附且平板闲置时会保持唤醒（耗笔的电）。
REFRESH_SECONDS=0
