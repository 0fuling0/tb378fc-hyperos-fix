# 唤醒 / 胶囊 策略配置
#
# REFRESH_SECONDS=0   只按吸附状态触发（默认）：
#                       取下 -> 发唤醒命令
#                       吸附 -> 弹原生电量胶囊（见 CAPSULE）
#                     其余时间不打扰，笔按自己的节奏休眠
#
# REFRESH_SECONDS=120 额外安全网：未吸附期间每 120 秒补发一次唤醒。
#                     适合"笔搁在桌上睡死了、你又不想吸附一下"的场景，
#                     代价是笔在未吸附且平板闲置时会保持唤醒（耗笔的电）。
REFRESH_SECONDS=0

# CAPSULE=1   吸附时弹 HyperOS 原生电量胶囊（默认开）。
#             也可以建一个 disable-capsule 标记文件单独关掉（唤醒照常）。
#             参数语义见 docs/native-stylus-capsule.md。
CAPSULE=1

# POLL_MS     吸附检测的轮询间隔（毫秒）。检测是轮询 /sys/class/power_supply/wls_tx/attached，
#             这个值直接决定"吸上去多久才弹"：
#               200 = 默认（最坏 0.2s 发现，实测总延迟 ~0.5s）
#               500 / 1000 = 更省电、更迟钝
#               100 / 50  = 更灵敏（轮询用 shell 内建 read，代价很小）
POLL_MS=200

# CAPSULE_DIRECT=1  守护**自己**直接发原生 STYLUS_STATE_SOC 广播（默认）。
#                   少一跳：不用先叫醒 PenBridge 应用进程，实测能省 0.3~1s。
#                   0 = 只发 ATTACH 给 PenBridge，由应用组装并弹（老路径）
CAPSULE_DIRECT=1

# CAPSULE_GATT=1    直发之后再让 PenBridge 用 GATT 读一次真电量（0x180F/0x2A19），
#                   与已显示的数字**不同**才补弹一条校正。读到相同值不会重复弹。
#                   想要"一次就完、不要第二次弹窗"可以设 0（那就只信任线圈电量）。
CAPSULE_GATT=1

# CAPSULE_FAST=1     边沿一到就用上一次的线圈电量先弹（~0.2s 出胶囊），1~2 秒后拿新值刷新。
#                   0 = 不抢跑，等线圈报出本次的新值再弹（慢 1~2 秒，但第一眼就是真值）。
CAPSULE_FAST=0

# TOUCHFILM   笔端"触控膜功能位" `{8,6,mask}`：笔上报哪些手势的总开关。
#             位（ZUX buildTouchfilmEnable，见 docs/zuxos-pen-protocol.md §2.1）：
#               0x01 双击 / 0x02 三击 / 0x04 上滑 / 0x08 下滑 / 0x10 捏合 / 0x20 笔尾
#             63 = 0x3F 全开（默认）：开机 + 每次取下笔都补发一次。
#             笔一旦重启/睡死/被别的程序写成 0，双击/上滑/下滑/捏合就再也不上报
#             （笔尖写字不受影响）；联想原厂是每次连接都重发一次全量 mask。
#             -1 = 只唤醒，不动手势位。
TOUCHFILM=63

# GESTURE     手势桥（bin/penring）开关：1 = 常驻（默认），0 = 不起。
#             也可以建一个 disable-gesture 标记文件。详见 docs/stylus-gesture-bridge.md。
GESTURE=1

# 下面这几项是"联想笔的手势 → 注入哪个 Android 键码"，改完重启模块生效，-1 = 关掉这条。
#   194 轻捏（HyperOS 快捷环；系统级，任何 App 都弹）
#   195 双击（MIUI 双击功能；只有小米创作 / 自己开过触控膜的 App 有反应）
#   196 上滑 / 197 下滑（MIUI 上滑下滑；白名单 App 会被 MIUI 转成 92/93 翻页）
#    92 截图键 / 93 速记键（"按住这个键 + 点屏幕"= 截图标注 / 灵感速记，系统级）
# 想要"任何 App 里上滑下滑都翻页"，把 GESTURE_SLIDE_UP/DOWN 改成 92/93
# （那就等于直接发 PAGE_UP/PAGE_DOWN，代价是 380ms 内会被 MIUI 当成截图/速记键待命）。
GESTURE_RING=194
GESTURE_DOUBLE=195
GESTURE_SLIDE_UP=196
GESTURE_SLIDE_DOWN=197
# 笔尾那个按键：92 = 截图键（默认），93 = 速记键，-1 = 不管
GESTURE_TAIL=92

# SETTINGS_SYNC=1  把"设置 → 手写笔"里改的东西实时路由给笔（默认）：
#                   双击开关  -> {8,6,mask} bit0
#                   轻捏开关  -> {8,6,mask} bit4
#                   轻捏力度  -> {8,5,level}（设置里 0..4 → 笔端 1..5）
#                  MIUI 自己那份设置只对它自家笔有效（丢给自己的 BLE 服务），
#                  联想笔听不懂，所以由守护每 2 秒核对一次、变了就发等价帧。
#                  0 = 只按上面的固定映射下发，不跟随设置。
SETTINGS_SYNC=1

# ---------------------------------------------------------------- ⑦ 笔刷触感（跟随 App 的笔刷）
# 读笔记/小米创作的 current_brush（root 可读的 prefs），切一次发一次 CON 波形；
# 笔尾（BTN_TOOL_RUBBER）靠近发 BRUSH_ERASER、离开恢复当前笔刷；
# 只有 LSPosed hook 报 canvas=1（编辑器 Activity 且无弹窗）时才发波形。
BRUSH=1
BRUSH_APPS="com.miui.notes com.miui.creation"
BRUSH_LEVEL=3
BRUSH_FRICTION=1
# current_brush 编号 -> CON 波形（实测：1 钢笔 / 2 圆珠笔 / 3 铅笔 / 4 马克笔 / 10 毛笔）
# 波形：32 圆珠笔 / 33 铅笔 / 34 马克笔 / 35 橡皮 / 36 联想笔刷 / 37..41 无音效版
BRUSH_MAP="1:32,2:32,3:33,4:34,10:36"
# 工具栏工具值（select_state_save）实测：8 = AI 笔 / 6 = 框选笔 / 7 = 橡皮
# 这三类都不改 current_brush（还停在上一支真笔刷上），所以判定时优先看 select_state_save
BRUSH_AI_STATES="8"
BRUSH_AI_WAVE=36
# 框选笔：同样不改 current_brush，用 select_state_save=6 标识
BRUSH_LASSO_STATES="6"
BRUSH_LASSO_WAVE=36
# 认不出的编号统一用这个波形
BRUSH_DEFAULT_WAVE=36
# 笔尾（橡皮端）靠近时用的波形
BRUSH_ERASER=35
# 工具状态 select_state_save 取这些值时也算橡皮（UI 里选橡皮时 current_brush 不变）
BRUSH_ERASER_STATES="7"
BRUSH_STATE_KEYS="current_brush select_state_save ai_type current_ai_brush"
# 退出应用/离开画布后自动停波形
BRUSH_EXIT_CHECK=1

# ⑨ 休眠档：吸附在平板上且已充满 → 停掉一切对笔的主动动作（唤醒/胶囊/GATT 校正/波形），
#    并让 App 断掉"留给下一条手势"的缓存 BLE 连接，让笔真正睡下去（不再被每几秒吵醒）。
#    取下、或电量掉到 REST_RESUME 以下 → 立刻恢复。每天夜里都吸在平板上时最有用。
PEN_REST=1
# 主判据：charge_state（线圈驱动报的"是否正在给笔充电"）由 1 变 0 并持续 REST_IDLE 秒 → 充完了
#   （刚吸上去那几秒 chg 也是 0 —— 握手没起来，所以必须"先见到过 chg=1"才算数）
REST_IDLE=20
# 兜底判据：电量 ≥ REST_FULL（有的笔端在 100% 前就停充，或 chg 读不到时用）
REST_FULL=99
REST_POLL=60          # 休眠期间线圈电量/充电状态轮询间隔（秒）
# 出档：取下，或线圈重新开始充电（chg=1）—— 不能用"电量低于阈值"出档，会和"停充进档"打架

# ⑩ 笔尾 = 橡皮：笔尾靠近/离开各注入一次"双击键"，让 MIUI 执行"笔刷/橡皮切换"。
#    前提：设置 → 手写笔 → 双击 要选成"笔刷/橡皮切换"（对应值 1）。0 = 关掉这个功能。
TAIL_TAP_ERASER=1
